---
import Marquee from './Marquee.astro';
import PixelCluster from './PixelCluster.astro';

const heroImg = 'https://scontent-ams2-1.cdninstagram.com/v/t51.71878-15/605284339_1905742720329149_581982739458372117_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=107&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0xJUFMuYmVzdF9pbWFnZV91cmxnZW4uQzMifQ%3D%3D&_nc_ohc=2fz6fKA10W4Q7kNvwG5Lztp&_nc_oc=Adq7M0ZbnqnNhXh0EGq3h7FUh8PfIL2vA0pe8S-MEIPvhI1NFG1IBX0xCrv3apsdk0Q&_nc_zt=23&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=iAL__7EhTh02EJiDKyhXhA&_nc_ss=7ba8c&oh=00_AQMtJrnEXJMXPvTdJYX2XAmNcX4Mxo2lIJ9zLmfiQIrQvA&oe=6AC12630';
const heroImg2 = 'https://scontent-ams2-1.cdninstagram.com/v/t51.82787-15/749440596_18122789392707619_327884191046454746_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=101&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0xJUFMuYmVzdF9pbWFnZV91cmxnZW4uQzMifQ%3D%3D&_nc_ohc=v-HZ9u9HcMoQ7kNvwHaYvZ0&_nc_oc=AdpX6ODiO4ENF1jbplfANsGyenRTEEfc7X9rYf_ghMXVBJ_kKHOUsU576d4dYLjnsxY&_nc_zt=23&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=iAL__7EhTh02EJiDKyhXhA&_nc_ss=7ba8c&oh=00_AQM6VoilIvPdMMrnRWXHtMY5gDlfauH5ujx9zCAmyoEovw&oe=6AC1182A';
---
<section id="top" class="relative overflow-hidden bg-butter-tint paper-overlay pt-32 md:pt-40">
  <!-- Soft organic blob behind hero product -->
  <div class="pointer-events-none absolute left-1/2 top-1/2 -z-0 h-[640px] w-[640px] -translate-x-1/2 -translate-y-1/2 rounded-[50%_45%_55%_48%/55%_60%_40%_45%] bg-butter-light blur-[2px] opacity-70"></div>

  <!-- Pixel cluster top-right -->
  <PixelCluster variant="butter-lav" class="absolute right-6 top-24 z-10 hidden md:block" rows={7} cols={7} size={16} />

  <div class="container-x relative z-10 grid grid-cols-1 items-center gap-10 pb-28 md:grid-cols-12 md:gap-6 md:pb-36">
    <!-- Copy -->
    <div class="md:col-span-7">
      <p class="eyebrow reveal">NooK Café · Basra · Est. 2017</p>
      <h1 class="display mt-4 text-[64px] leading-[0.85] sm:text-[88px] md:mt-5 md:text-[120px] lg:text-[148px]">
        <span class="block reveal" style="transition-delay:80ms">Every Day,</span>
        <span class="block reveal text-anchor" style="transition-delay:220ms">
          A Little <span class="text-stroke-anchor">Mood.</span>
        </span>
      </h1>
      <p class="reveal mt-7 max-w-[36ch] text-base leading-relaxed text-anchor/75 md:text-lg" style="transition-delay:340ms">
        A neighborhood café on Saeed Hamid Street, Basra — pour-over coffee, Spanish latte, hot
        chocolate, and stone-oven pizza. Eight years of conversations, cups and croissants.
      </p>
      <div class="reveal mt-8 flex flex-wrap items-center gap-4" style="transition-delay:440ms">
        <a href="#menu" class="pill-primary">
          See the menu
          <span class="arrow-chip"><svg width="11" height="11" viewBox="0 0 24 24" fill="none"><path d="M5 19L19 5M19 5H8M19 5v11" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </a>
        <a href="#visit" class="group inline-flex items-center gap-2 font-mono text-xs uppercase tracking-mono text-anchor hover:text-pop-pinkDeep">
          Find us in Basra
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="transition-transform duration-300 group-hover:translate-x-1"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>

    <!-- Hero product stack -->
    <div class="relative md:col-span-5">
      <div class="relative mx-auto aspect-square w-full max-w-[460px]">
        <!-- Decorative scatter dots -->
        <span class="sticker left-[-12%] top-[8%] h-10 w-10 rounded-full bg-pop-pink shadow-chunk animate-float-slow" style="animation-delay:.1s"></span>
        <span class="sticker right-[-8%] top-[2%] h-6 w-6 rounded-full bg-pop-lavender shadow-chunk animate-float-med"></span>
        <span class="sticker left-[6%] bottom-[14%] h-7 w-7 rounded-full bg-anchor shadow-chunk-pink animate-float-slow" style="animation-delay:.6s"></span>
        <span class="sticker right-[-10%] bottom-[8%] h-12 w-12 rounded-full bg-pop-pink animate-float-med" style="animation-delay:.3s"></span>

        <!-- Back product -->
        <img
          src={heroImg2}
          alt="NooK signature cold brew"
          width="640"
          height="640"
          loading="eager"
          class="reveal absolute left-[8%] top-[14%] aspect-square w-[58%] -rotate-[8deg] rounded-[28px] border-[6px] border-cream object-cover shadow-chunk"
          style="transition-delay:380ms"
        />
        <!-- Front product -->
        <img
          src={heroImg}
          alt="NooK signature hot chocolate"
          width="640"
          height="640"
          loading="eager"
          class="reveal absolute right-[6%] top-[28%] aspect-square w-[64%] rotate-[4deg] rounded-[36px] border-[6px] border-cream object-cover shadow-chunk-pink"
          style="transition-delay:500ms"
        />

        <!-- Floating ingredient stickers -->
        <span class="sticker right-[12%] top-[-2%] rotate-[-12deg] rounded-2xl border-2 border-anchor bg-cream px-3 py-1.5 font-mono text-[10px] uppercase tracking-mono text-anchor shadow-soft animate-float-slow">
          Hot Choc ★
        </span>
        <span class="sticker left-[14%] bottom-[2%] rotate-[6deg] rounded-2xl border-2 border-anchor bg-butter px-3 py-1.5 font-mono text-[10px] uppercase tracking-mono text-anchor shadow-soft animate-float-med">
          Spanish Latte
        </span>
      </div>

      <!-- Stat trio -->
      <dl class="mt-8 grid grid-cols-3 gap-2 rounded-3xl border-2 border-anchor bg-cream/80 p-4 backdrop-blur md:mt-2 md:absolute md:-bottom-2 md:left-0 md:right-0">
        <div class="text-center md:border-r md:border-anchor/15">
          <dt class="eyebrow">Google</dt>
          <dd class="display text-3xl text-anchor md:text-4xl">
            <span data-count="4.2" data-suffix="★">0★</span>
          </dd>
          <dd class="font-mono text-[10px] uppercase tracking-mono text-anchor/60">Rating</dd>
        </div>
        <div class="text-center md:border-r md:border-anchor/15">
          <dt class="eyebrow">Followers</dt>
          <dd class="display text-3xl text-anchor md:text-4xl">
            <span data-count="31.8" data-suffix="K+">0K+</span>
          </dd>
          <dd class="font-mono text-[10px] uppercase tracking-mono text-anchor/60">On Instagram</dd>
        </div>
        <div class="text-center">
          <dt class="eyebrow">Since</dt>
          <dd class="display text-3xl text-anchor md:text-4xl">
            <span data-count="8" data-suffix="YRS">0YRS</span>
          </dd>
          <dd class="font-mono text-[10px] uppercase tracking-mono text-anchor/60">Of Mood</dd>
        </div>
      </dl>
    </div>
  </div>

  <!-- Tilted marquee ribbon -->
  <div class="absolute -bottom-10 left-0 right-0 z-20">
    <Marquee
      words={['Every Day Mood', 'Spanish Latte', 'Hot Chocolate', 'Stone-Oven Pizza', 'Espresso Bar', 'Basra, Iraq']}
      variant="pink"
      glyph="✶"
      tilt={-2.6}
    />
  </div>
</section>