---
const rating = 4.2;
const totalReviews = 236;
---
<section class="relative pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden bg-brand-100/30">
  <!-- Decorative background pattern -->
  <div class="absolute inset-0 z-0 opacity-20" style="background-image: radial-gradient(#B27B41 1px, transparent 1px); background-size: 32px 32px;"></div>
  
  <div class="container mx-auto px-4 md:px-6 relative z-10">
    <div class="flex flex-col lg:flex-row items-center gap-12">
      <div class="w-full lg:w-1/2 space-y-8 text-center lg:text-left pt-10">
        <div class="inline-flex items-center gap-2 bg-white px-4 py-2 rounded-full shadow-sm border border-brand-100">
          <span class="text-yellow-500">★</span>
          <span class="font-semibold text-sm">{rating} on Google Reviews ({totalReviews} reviews)</span>
        </div>
        
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-serif font-bold leading-tight text-brand-900">
          Discover Your <br/>
          <span class="text-brand-500 italic relative whitespace-nowrap">
            Perfect Nook
            <svg class="absolute w-full h-3 -bottom-1 left-0 text-brand-500/30" viewBox="0 0 100 10" preserveAspectRatio="none"><path d="M0 5 Q 50 10 100 5" stroke="currentColor" stroke-width="3" fill="transparent"/></svg>
          </span>
        </h1>
        
        <p class="text-lg md:text-xl text-brand-900/80 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
          Escape the ordinary and step into Basrah's most inviting café. Whether you're seeking a quiet corner to work, a catch-up spot with friends, or the perfect artisan brew, NooK Café welcomes you.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start pt-4">
          <a href="#visit" class="inline-flex justify-center items-center px-8 py-4 bg-brand-900 text-white font-medium rounded-full hover:bg-brand-600 transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-0.5">
            Come Say Hello
          </a>
          <a href="https://www.instagram.com/nook_iraq/" target="_blank" rel="noopener noreferrer" class="inline-flex justify-center items-center px-8 py-4 bg-white text-brand-900 border-2 border-brand-100 font-medium rounded-full hover:bg-brand-50 transition-all shadow-sm">
            Follow @nook_iraq
          </a>
        </div>
      </div>
      
      <div class="w-full lg:w-1/2 relative mt-10 lg:mt-0">
        <div class="relative rounded-2xl overflow-hidden shadow-2xl rotate-2 hover:rotate-0 transition-transform duration-500">
          <div class="absolute inset-0 bg-brand-900/10 mix-blend-multiply"></div>
          <img 
            src="https://images.unsplash.com/photo-1554118811-1e0d58224f24?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80" 
            alt="Interior of NooK Cafe with warm lighting" 
            class="w-full h-[500px] object-cover"
          />
        </div>
        <!-- Floating badge -->
        <div class="absolute -bottom-6 -left-6 bg-white p-6 rounded-xl shadow-xl border border-brand-100 hidden md:block">
          <p class="font-serif text-2xl text-brand-900 font-bold mb-1">Basrah</p>
          <p class="text-sm text-brand-900/60 font-medium">Downtown Escape</p>
        </div>
      </div>
    </div>
  </div>
</section>