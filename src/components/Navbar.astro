---
import { SITE } from '../data/site.js';

const links = [
  { label: 'Menu', href: '#menu' },
  { label: 'About', href: '#about' },
  { label: 'Visit', href: '#visit' }
];
const linksRight = [
  { label: 'Reviews', href: '#reviews' },
  { label: 'Instagram', href: SITE.instagram, external: true }
];
---

<!-- Ticker notice: honest, sourced from the cafe's own most recent announcement -->
<div class="bg-pink border-b-2 border-anchor">
  <p
    class="mx-auto flex max-w-content flex-wrap items-center justify-center gap-x-3 gap-y-1 px-4 py-2 text-center font-mono text-[11px] font-bold uppercase tracking-[0.18em] text-anchor"
  >
    <span aria-hidden="true">★</span>
    NooK is moving — temporarily closed while we find our new Basra home.
    <a href={SITE.instagram} class="underline underline-offset-4" target="_blank" rel="noopener noreferrer"
      >Follow {SITE.handle} for the reopening</a
    >
    <span aria-hidden="true">★</span>
  </p>
</div>

<header class="sticky top-3 z-50 px-3 sm:px-5" id="site-nav">
  <nav
    aria-label="Primary"
    class="mx-auto flex max-w-content items-center justify-between gap-3 rounded-full border-2 border-anchor/12 bg-cream/95 px-3 py-2 shadow-[0_10px_30px_-18px_rgba(42,26,18,0.55)] backdrop-blur-sm sm:px-5"
  >
    <!-- Left links -->
    <ul class="hidden items-center gap-6 lg:flex">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="font-mono text-[11px] font-bold uppercase tracking-[0.2em] text-anchor/80 transition hover:text-anchor"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Mobile menu button (left on mobile) -->
    <button
      type="button"
      class="flex h-10 w-10 items-center justify-center rounded-full border-2 border-anchor bg-butter text-anchor lg:hidden"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>

    <!-- Centered logo -->
    <a href="#top" class="group flex items-center gap-3" aria-label={`${SITE.name} — home`}>
      <img
        src={SITE.profilePic}
        alt={`${SITE.name} logo`}
        width="48"
        height="48"
        class="h-11 w-11 rounded-full border-2 border-anchor object-cover transition-transform duration-300 group-hover:rotate-6 sm:h-12 sm:w-12"
      />
      <span class="hidden font-display text-lg uppercase tracking-tight sm:block">NooK</span>
    </a>

    <!-- Right zone -->
    <div class="flex items-center gap-2">
      <ul class="hidden items-center gap-6 lg:flex">
        {
          linksRight.map((l) => (
            <li>
              <a
                href={l.href}
                target={l.external ? '_blank' : undefined}
                rel={l.external ? 'noopener noreferrer' : undefined}
                class="font-mono text-[11px] font-bold uppercase tracking-[0.2em] text-anchor/80 transition hover:text-anchor"
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>

      <a
        href={SITE.phoneHref}
        class="hidden items-center gap-2 rounded-full border-2 border-anchor bg-butter px-4 py-2 font-mono text-[11px] font-bold uppercase tracking-[0.16em] transition hover:-translate-y-0.5 hover:bg-golden md:inline-flex"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z" />
        </svg>
        Call
      </a>

      <a
        href={SITE.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="flex h-10 w-10 items-center justify-center rounded-full border-2 border-anchor bg-pink transition hover:-translate-y-0.5 hover:bg-lavender"
        aria-label={`${SITE.name} on Instagram`}
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="3.6" />
          <circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" />
        </svg>
      </a>
    </div>
  </nav>
</header>

<!-- Mobile full-screen menu -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-[60] hidden flex-col bg-butter px-6 pb-10 pt-6"
  data-mobile-menu
  role="dialog"
  aria-modal="true"
  aria-label="Site menu"
>
  <div class="flex items-center justify-between">
    <img src={SITE.profilePic} alt={`${SITE.name} logo`} width="52" height="52" class="h-13 w-13 rounded-full border-2 border-anchor object-cover" />
    <button
      type="button"
      class="flex h-11 w-11 items-center justify-center rounded-full border-2 border-anchor bg-cream"
      data-menu-close
      aria-label="Close menu"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6 6 18" />
      </svg>
    </button>
  </div>

  <ul class="mt-12 flex flex-col gap-2">
    {
      [...links, ...linksRight].map((l) => (
        <li>
          <a
            href={l.href}
            target={l.external ? '_blank' : undefined}
            rel={l.external ? 'noopener noreferrer' : undefined}
            class="display block border-b-2 border-anchor/20 py-4 text-4xl"
            data-menu-link
          >
            {l.label}
          </a>
        </li>
      ))
    }
  </ul>

  <div class="mt-auto space-y-3">
    <a href={SITE.phoneHref} class="flex items-center justify-center gap-3 rounded-full border-2 border-anchor bg-golden py-4 font-mono text-xs font-bold uppercase tracking-[0.2em]">
      Call {SITE.phone}
    </a>
    <a href={SITE.mapsUrl} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-3 rounded-full border-2 border-anchor bg-pink py-4 font-mono text-xs font-bold uppercase tracking-[0.2em]">
      Get directions
    </a>
  </div>
</div>

<script>
  const toggle = document.querySelector('[data-menu-toggle]');
  const menu = document.querySelector('[data-mobile-menu]') as HTMLElement | null;
  const close = document.querySelector('[data-menu-close]');

  const openMenu = () => {
    menu?.classList.remove('hidden');
    menu?.classList.add('flex');
    toggle?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  };
  const closeMenu = () => {
    menu?.classList.add('hidden');
    menu?.classList.remove('flex');
    toggle?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  };

  toggle?.addEventListener('click', openMenu);
  close?.addEventListener('click', closeMenu);
  document.querySelectorAll('[data-menu-link]').forEach((l) => l.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });

  /* Navbar gains a touch more presence on scroll */
  const nav = document.getElementById('site-nav');
  window.addEventListener('scroll', () => {
    if (!nav) return;
    nav.style.transform = window.scrollY > 60 ? 'scale(0.985)' : 'scale(1)';
    nav.style.transition = 'transform .35s cubic-bezier(.2,.8,.3,1)';
  });
</script>