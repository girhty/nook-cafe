---
const logo = 'https://scontent-ams2-1.cdninstagram.com/v/t51.82787-19/752682442_18123178903707619_8012619269466550386_n.jpg?stp=dst-jpg_s150x150_tt6&_nc_cat=110&ccb=7-5&_nc_sid=f7ccc5&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLnd3dy45NTEuQzMifQ%3D%3D&_nc_ohc=yNp92vqcr54Q7kNvwHqnp4c&_nc_oc=AdoJkLHWrVg2gHJqggvC-_UxKsVZbUgBt0vgOFCORWfQoCTmQGury6TQwVs79x8wTQQ&_nc_zt=24&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=z49Rb442usHEBRVcn9quHg&_nc_ss=7ba8c&oh=00_AQNzEyerPYRL3RJuKQp_zofKmpmm3IV8tAbZgyIhujoS6Q&oe=6AC10A94';
---
<header class="fixed inset-x-0 top-4 z-50 px-4 md:top-6 md:px-8">
  <nav
    data-nav
    class="mx-auto flex max-w-[1240px] items-center justify-between gap-4 rounded-full border border-anchor/10 bg-cream/95 px-3 py-2.5 backdrop-blur transition-all duration-300 md:px-5 md:py-3"
    aria-label="Primary"
  >
    <!-- Left links -->
    <ul class="hidden items-center gap-6 md:flex">
      <li><a href="#about" class="font-mono text-[11px] uppercase tracking-mono text-anchor/80 hover:text-anchor">About</a></li>
      <li><a href="#menu" class="font-mono text-[11px] uppercase tracking-mono text-anchor/80 hover:text-anchor">Menu</a></li>
      <li><a href="#visit" class="font-mono text-[11px] uppercase tracking-mono text-anchor/80 hover:text-anchor">Visit</a></li>
    </ul>

    <!-- Centered Logo -->
    <a href="#top" class="group relative -my-1 flex items-center justify-center">
      <span class="absolute -inset-2 rounded-full bg-butter/60 blur-md opacity-0 transition-opacity duration-300 group-hover:opacity-100"></span>
      <img
        src={logo}
        alt="NooK Café logo"
        class="relative h-11 w-11 rounded-full border-2 border-anchor bg-cream object-cover transition-transform duration-300 group-hover:rotate-[5deg] md:h-12 md:w-12"
        width="48"
        height="48"
        loading="eager"
      />
    </a>

    <!-- Right links -->
    <div class="flex items-center gap-3">
      <a href="#contact" class="hidden font-mono text-[11px] uppercase tracking-mono text-anchor/80 hover:text-anchor md:inline">Contact</a>
      <button
        type="button"
        class="hidden items-center gap-1 rounded-full border-2 border-anchor px-3 py-1.5 font-mono text-[11px] uppercase tracking-mono text-anchor hover:bg-anchor hover:text-cream md:flex"
        aria-haspopup="true"
      >
        Pages
        <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="M2 3.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <a
        href="https://nook-iraq.com/menu"
        target="_blank"
        rel="noopener"
        aria-label="View menu"
        class="grid h-9 w-9 place-items-center rounded-full bg-anchor text-butter transition-transform hover:rotate-[-6deg]"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 6h16l-1.5 12.2a2 2 0 0 1-2 1.8H7.5a2 2 0 0 1-2-1.8L4 6Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M9 6V4a3 3 0 0 1 6 0v2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </a>
      <button data-burger class="grid h-9 w-9 place-items-center rounded-full bg-butter text-anchor md:hidden" aria-label="Open menu">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
    </div>
  </nav>
</header>

<!-- Mobile menu -->
<div
  data-mobile-menu
  class="fixed inset-0 z-40 hidden bg-anchor text-cream md:hidden"
  aria-hidden="true"
>
  <div class="flex h-full flex-col items-center justify-center gap-6 p-10 text-center">
    <a href="#about" class="display text-5xl">About</a>
    <a href="#menu" class="display text-5xl">Menu</a>
    <a href="#craft" class="display text-5xl">Craft</a>
    <a href="#reviews" class="display text-5xl">Reviews</a>
    <a href="#visit" class="display text-5xl text-butter">Visit</a>
    <a href="https://instagram.com/nook_iraq" target="_blank" rel="noopener" class="pill-primary mt-4">@nook_iraq <span class="arrow-chip"><svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M5 19L19 5M19 5H8M19 5v11" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></span></a>
  </div>
</div>