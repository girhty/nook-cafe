---
const images = [
  { src: "https://images.unsplash.com/photo-1497935586351-b67a49e012bf?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80", alt: "Cappuccino art" },
  { src: "https://images.unsplash.com/photo-1509042239860-f550ce710b93?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80", alt: "Cafe seating area" },
  { src: "https://images.unsplash.com/photo-1555507036-ab1e4006aaeb?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80", alt: "Fresh pastries" },
  { src: "https://images.unsplash.com/photo-1559925393-8be0ec4767c8?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80", alt: "Coffee beans" },
];
---
<section id="gallery" class="py-20 bg-brand-100/30">
  <div class="container mx-auto px-4 md:px-6">
    <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6">
      <div class="max-w-2xl">
        <h2 class="text-3xl md:text-4xl font-serif font-bold text-brand-900 mb-4">Instagram Favorites</h2>
        <p class="text-lg text-brand-900/70">Tag us <a href="https://www.instagram.com/nook_iraq/" target="_blank" class="text-brand-500 font-semibold hover:underline">@nook_iraq</a> to be featured in our gallery. See what our community is sipping on!</p>
      </div>
      <a href="https://www.instagram.com/nook_iraq/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-brand-900 font-semibold hover:text-brand-500 transition-colors">
        View Profile 
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {images.map((img) => (
        <div class="group relative overflow-hidden rounded-xl aspect-square shadow-sm">
          <img 
            src={img.src} 
            alt={img.alt} 
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
          />
          <div class="absolute inset-0 bg-brand-900/50 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
            <div class="text-white flex items-center gap-4">
              <span class="flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd" /></svg> 142</span>
              <span class="flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10c0 3.866-3.582 7-8 7a8.841 8.841 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7zM7 9H5v2h2V9zm8 0h-2v2h2V9zM9 9h2v2H9V9z" clip-rule="evenodd" /></svg> 18</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>