---
import { SITE } from '../data/site.js';

const photoA = SITE.posts[1];
const photoB = SITE.posts[4];
---

<section id="about" class="relative overflow-hidden bg-cream py-24 md:py-36">
  <div class="mx-auto max-w-content px-5">
    <div class="relative mx-auto max-w-4xl text-center">
      <!-- Tilted photo, left -->
      <figure
        class="absolute -left-4 top-0 hidden w-40 -rotate-6 overflow-hidden rounded-2xl border-[6px] border-cream shadow-hard-sm md:block lg:-left-24 lg:w-48"
        data-reveal
        style="--d:120ms"
      >
        <img
          src={photoA.image}
          alt="NooK Café signature drinks lined up on the bar"
          width="320"
          height="320"
          loading="lazy"
          class="aspect-square w-full object-cover"
        />
      </figure>

      <!-- Tilted photo, right -->
      <figure
        class="absolute -right-4 bottom-4 hidden w-40 rotate-6 overflow-hidden rounded-2xl border-[6px] border-butter shadow-hard-sm md:block lg:-right-24 lg:w-48"
        data-reveal
        style="--d:260ms"
      >
        <img
          src={photoB.image}
          alt="Guests sharing an evening at a NooK Café community event"
          width="320"
          height="320"
          loading="lazy"
          class="aspect-square w-full object-cover"
        />
      </figure>

      <p class="eyebrow text-anchor/60" data-reveal>About us</p>

      <h2 class="display h-sub mt-6 leading-[1.05]" data-reveal style="--d:80ms">
        We keep the lights warm and the cups full — eight years in Basra, one mood
        only: good.
      </h2>

      <a
        href="#menu"
        class="group mt-10 inline-flex items-center gap-3 rounded-full border-2 border-anchor bg-pink py-2.5 pl-6 pr-2.5 font-mono text-[11px] font-bold uppercase tracking-[0.2em] shadow-[0_6px_0_0_#2A1A12] transition duration-300 hover:-translate-y-1 hover:shadow-[0_11px_0_0_#2A1A12]"
        data-reveal
        style="--d:180ms"
      >
        See the signature menu
        <span class="flex h-9 w-9 items-center justify-center rounded-full border-2 border-anchor bg-cream transition-transform duration-300 group-hover:rotate-45">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </span>
      </a>

      <p class="mt-8 font-mono text-[11px] font-bold uppercase tracking-[0.2em] text-anchor/50" data-reveal style="--d:240ms">
        {SITE.taglineAr} · {SITE.tagline}
      </p>
    </div>
  </div>
</section>