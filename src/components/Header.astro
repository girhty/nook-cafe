<header class="fixed w-full top-0 z-50 bg-brand-50/95 backdrop-blur-sm shadow-sm border-b border-brand-100">
  <div class="container mx-auto px-4 md:px-6 h-20 flex items-center justify-between">
    <a href="/" class="text-2xl font-serif font-bold text-brand-900 tracking-tight flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-brand-500" viewBox="0 0 24 24" fill="currentColor">
        <path d="M20 3H4v10c0 2.21 1.79 4 4 4h6c2.21 0 4-1.79 4-4v-3h2c1.11 0 2-.9 2-2V5c0-1.11-.89-2-2-2zm0 5h-2V5h2v3zM4 19h16v2H4v-2z"/>
      </svg>
      NooK Café
    </a>
    
    <nav class="hidden md:flex gap-8 items-center font-medium text-sm">
      <a href="#about" class="hover:text-brand-500 transition-colors">About</a>
      <a href="#gallery" class="hover:text-brand-500 transition-colors">Gallery</a>
      <a href="#reviews" class="hover:text-brand-500 transition-colors">Reviews</a>
      <a href="#visit" class="bg-brand-900 text-brand-50 px-6 py-2.5 rounded-full hover:bg-brand-600 transition-colors shadow-md">
        Visit Us
      </a>
    </nav>

    <!-- Mobile menu button (visual only for static) -->
    <button class="md:hidden p-2 text-brand-900" aria-label="Menu">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
</header>