---
export interface Props {
  words: string[];
  variant?: 'pink' | 'butter' | 'dark';
  reverse?: boolean;
  glyph?: string;
  tilt?: number;
}
const { words, variant = 'pink', reverse = false, glyph = '✶', tilt = 2.2 } = Astro.props;

const bg = {
  pink: 'bg-pop-pink text-anchor',
  butter: 'bg-butter text-anchor',
  dark: 'bg-anchor text-cream',
}[variant];

const content = Array.from({ length: 6 }, () => words).flat();
---
<div
  class="relative w-full overflow-hidden marquee-mask"
  style={`transform: rotate(${tilt}deg);`}
  aria-hidden="true"
>
  <div
    class={`flex w-max ${reverse ? 'animate-marquee-rev' : 'animate-marquee'} gap-12 py-5 ${bg}`}
    style="border-top: 2px solid #2E1A12; border-bottom: 2px solid #2E1A12;"
  >
    {content.map((w, i) => (
      <span class="display whitespace-nowrap text-4xl md:text-6xl lg:text-7xl">
        <span class="opacity-70 mr-12">{glyph}</span>{w}
      </span>
    ))}
  </div>
</div>