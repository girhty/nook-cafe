---
<section id="craft" class="relative bg-cream-200 py-28 md:py-40" style="background-color:#F1E5C8;">
  <div class="container-x">
    <div class="grid items-end gap-6 md:grid-cols-12">
      <div class="md:col-span-7">
        <p class="eyebrow reveal">The Craft · الصناعة</p>
        <h2 class="display reveal mt-4 text-5xl text-anchor sm:text-6xl md:text-7xl md:leading-[0.85]" style="transition-delay:120ms">
          <span class="block">Simple Ingredients.</span>
          <span class="block text-stroke-anchor">Careful Hands.</span>
        </h2>
      </div>
      <div class="md:col-span-5">
        <p class="reveal max-w-md text-base leading-relaxed text-anchor/75" style="transition-delay:240ms">
          Four steps, repeated all day. The good ones are rarely the loud ones.
        </p>
        <div class="mt-4 hidden md:block">
          <span class="block h-10 w-10 bg-butter"></span>
          <span class="mt-1 block h-10 w-10 bg-pop-lavender"></span>
        </div>
      </div>
    </div>

    <!-- Dark card -->
    <div class="reveal mt-12 rounded-[36px] bg-anchor p-6 text-cream md:mt-16 md:p-10" style="transition-delay:300ms">
      <div class="grid items-center gap-8 md:grid-cols-12">
        <div class="md:col-span-7">
          <div class="flex items-center gap-3">
            <span class="grid h-12 w-12 place-items-center rounded-xl bg-pop-lavender font-display text-xl text-anchor">
              <span id="craft-num">{steps[0].n}</span>
            </span>
            <span id="craft-label" class="font-mono text-[11px] uppercase tracking-mono text-cream/70">{steps[0].label}</span>
          </div>
          <h3 id="craft-title" class="display mt-5 text-4xl text-butter sm:text-5xl md:text-6xl md:leading-[0.9]">{steps[0].title}</h3>
          <p id="craft-body" class="mt-5 max-w-lg text-base leading-relaxed text-cream/80">{steps[0].body}</p>
        </div>
        <div class="md:col-span-5">
          <div class="relative">
            <span class="absolute right-3 top-3 -z-10 h-full w-full rounded-[24px] bg-pop-pink"></span>
            <img
              id="craft-img"
              src={steps[0].img}
              alt="Coffee craft step"
              loading="lazy"
              class="relative aspect-square w-full rounded-[24px] border-[5px] border-cream object-cover"
            />
          </div>
        </div>
      </div>

      <!-- Tabs -->
      <div class="mt-8 grid grid-cols-2 gap-0 border-t border-cream/15 md:grid-cols-4">
        {steps.map((s, i) => (
          <button
            type="button"
            data-step={i}
            data-step-data={JSON.stringify(s)}
            class={`craft-tab group border-cream/15 px-4 py-5 text-left transition md:border-r md:last:border-r-0 ${i === 0 ? 'is-active' : ''}`}
          >
            <div class="flex items-baseline gap-3">
              <span class="font-mono text-[10px] uppercase tracking-mono text-cream/60">{s.n}</span>
              <span class="font-mono text-[10px] uppercase tracking-mono text-cream/80 group-hover:text-butter">{s.label}</span>
            </div>
            <p class="display mt-2 text-xl text-cream sm:text-2xl md:text-3xl md:leading-[0.95]">{s.title}</p>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.craft-tab');
  const num = document.getElementById('craft-num');
  const label = document.getElementById('craft-label');
  const title = document.getElementById('craft-title');
  const body = document.getElementById('craft-body');
  const img = document.getElementById('craft-img') as HTMLImageElement | null;

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const data = tab.dataset.stepData;
      if (!data || !num || !label || !title || !body || !img) return;
      const s = JSON.parse(data);
      // animate out
      [num, label, title, body].forEach((el) => (el.style.opacity = '0'));
      img.style.opacity = '0';
      img.style.transform = 'scale(0.97)';
      setTimeout(() => {
        num.textContent = s.n;
        label.textContent = s.label;
        title.textContent = s.title;
        body.textContent = s.body;
        img.src = s.img;
        [num, label, title, body].forEach((el) => (el.style.transition = 'opacity 0.35s ease'));
        img.style.transition = 'opacity 0.45s ease, transform 0.45s ease';
        [num, label, title, body].forEach((el) => (el.style.opacity = '1'));
        img.style.opacity = '1';
        img.style.transform = 'scale(1)';
      }, 220);

      tabs.forEach((t) => t.classList.remove('is-active'));
      tab.classList.add('is-active');
    });
  });
</script>

<style>
  .craft-tab.is-active p {
    color: #F2C14E;
  }
</style>