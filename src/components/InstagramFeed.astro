---
import { SITE } from '../data/site.js';

const grid = SITE.posts.slice(0, 6);
---

<section id="instagram" class="relative bg-cream pb-24 md:pb-36">
  <div class="mx-auto max-w-content px-5">
    <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
      <div>
        <p class="eyebrow text-anchor/60">Instagram</p>
        <h2 class="display h-sub mt-4">
          @nook_iraq — <span class="text-golden">{SITE.followersLabel} followers</span>
        </h2>
      </div>
      <a
        href={SITE.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-3 rounded-full border-2 border-anchor bg-pink py-2.5 pl-6 pr-2.5 font-mono text-[11px] font-bold uppercase tracking-[0.2em] shadow-[0_6px_0_0_#2A1A12] transition duration-300 hover:-translate-y-1 hover:shadow-[0_11px_0_0_#2A1A12]"
      >
        Follow us
        <span class="flex h-9 w-9 items-center justify-center rounded-full border-2 border-anchor bg-cream transition-transform duration-300 group-hover:rotate-45">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </span>
      </a>
    </div>

    <ul class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-3" role="list">
      {
        grid.map((post, i) => (
          <li data-reveal style={`--d:${i * 70}ms`}>
            <a
              href={SITE.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="group relative block overflow-hidden rounded-3xl border-4 border-cream shadow-hard-sm transition duration-500 hover:-translate-y-2 hover:rotate-[-1deg] hover:shadow-hard"
            >
              <img
                src={post.image}
                alt={post.caption}
                width="500"
                height="500"
                loading="lazy"
                class="aspect-square w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <span class="absolute inset-x-0 bottom-0 translate-y-full bg-anchor/90 p-3 text-cream transition-transform duration-400 group-hover:translate-y-0">
                <span class="block font-mono text-[9px] font-bold uppercase tracking-[0.16em] text-butter">
                  {SITE.handle}
                </span>
                <span class="mt-1 line-clamp-2 block text-[11px] leading-snug">
                  {post.caption}
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>