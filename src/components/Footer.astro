---
import { SITE } from '../data/site.js';

const hero = SITE.posts[0];
const year = new Date().getFullYear();
---

<footer id="visit" class="relative overflow-hidden bg-anchor pb-10 pt-24 text-cream md:pt-32">
  <!-- Product, cropped by the footer edge -->
  <div class="pointer-events-none absolute -left-16 -top-10 hidden h-[420px] w-[420px] rotate-180 lg:block" aria-hidden="true">
    <div class="blob h-full w-full overflow-hidden border-4 border-cream/20 opacity-90">
      <img src={hero.image} alt="" width="520" height="520" loading="lazy" class="h-full w-full object-cover" />
    </div>
    <span class="prop absolute -right-6 top-10 h-9 w-9 rounded-full border-2 border-cream/40 bg-lavender" style="--fd:.4s"></span>
    <span class="prop absolute right-16 bottom-4 h-6 w-6 rotate-12 rounded-sm border-2 border-cream/40 bg-pink" style="--fd:.9s"></span>
  </div>

  <!-- Vertical SAY HELLO tab -->
  <a
    href={SITE.instagram}
    target="_blank"
    rel="noopener noreferrer"
    class="absolute right-0 top-24 z-20 hidden items-center gap-2 rounded-bl-2xl rounded-tl-2xl bg-lavender px-3 py-5 text-anchor md:flex"
    style="writing-mode: vertical-rl;"
  >
    <span class="font-mono text-[11px] font-bold uppercase tracking-[0.24em]">Say hello</span>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M7 17 17 7M9 7h8v8" />
    </svg>
  </a>

  <div class="relative mx-auto max-w-content px-5">
    <div class="lg:pl-[360px]">
      <p class="eyebrow text-butter" data-reveal>Visit us</p>
      <h2 class="display h-section mt-5 text-cream" data-reveal style="--d:60ms">
        Come find<br /><span class="text-golden">your nook.</span>
      </h2>

      <div class="mt-12 grid gap-6 md:grid-cols-2">
        <!-- Cream address card -->
        <article class="flex items-start justify-between gap-4 rounded-4xl border-2 border-cream/20 bg-cream p-6 text-anchor" data-reveal style="--d:120ms">
          <div>
            <p class="eyebrow text-anchor/55">Our address</p>
            <p class="display mt-3 text-2xl leading-tight md:text-3xl">
              {SITE.addressShort}
            </p>
            <p class="mt-3 text-[13px] leading-relaxed text-anchor/70" dir="auto">
              {SITE.address}
            </p>
          </div>
          <a
            href={SITE.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-1 flex h-12 w-12 shrink-0 items-center justify-center rounded-full border-2 border-anchor bg-lavender transition hover:-translate-y-1"
            aria-label="Open NooK Café location in Google Maps"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11Z" />
              <circle cx="12" cy="11" r="2.6" />
            </svg>
          </a>
        </article>

        <!-- Golden hours card -->
        <article class="rounded-4xl border-2 border-anchor bg-golden p-6 text-anchor" data-reveal style="--d:200ms">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="eyebrow text-anchor/60">See you there</p>
              <p class="display mt-3 text-2xl leading-tight md:text-3xl">
                Call ahead for today's hours
              </p>
              <p class="mt-3 text-[13px] leading-relaxed text-anchor/75">
                Opening hours aren't listed publicly yet — ring the bar and
                we'll tell you what's pouring.
              </p>
            </div>
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border-2 border-anchor bg-cream">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 7v5l3.2 2" />
              </svg>
            </span>
          </div>

          <div class="mt-5 flex flex-col gap-2 border-t-2 border-anchor/25 pt-4">
            <a href={SITE.phoneHref} class="font-mono text-[11px] font-bold uppercase tracking-[0.16em] underline decoration-2 underline-offset-4">
              0772 510 0008
            </a>
            <a href={SITE.phone2Href} class="font-mono text-[11px] font-bold uppercase tracking-[0.16em] underline decoration-2 underline-offset-4">
              0782 510 0008
            </a>
            <span class="mt-2 inline-flex w-fit items-center gap-2 rounded-full border-2 border-anchor bg-cream px-3 py-1 font-mono text-[10px] font-bold uppercase tracking-[0.16em]">
              <span class="h-2 w-2 rounded-full bg-pink" aria-hidden="true"></span>
              Temporarily closed — moving
            </span>
          </div>
        </article>
      </div>
    </div>

    <!-- Bottom row -->
    <div class="mt-16 grid gap-10 border-t-2 border-cream/20 pt-10 md:grid-cols-4">
      <div>
        <div class="flex items-center gap-3">
          <img src={SITE.profilePic} alt={`${SITE.name} logo`} width="52" height="52" loading="lazy" class="h-13 w-13 rounded-full border-2 border-cream object-cover" />
          <span class="display text-xl">NooK</span>
        </div>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-cream/70">
          {SITE.taglineAr} — {SITE.tagline}. Specialty coffee and a stone-fired
          kitchen in Basra.
        </p>
      </div>

      <nav aria-label="Quick links">
        <p class="eyebrow text-butter">Quick link</p>
        <ul class="mt-4 space-y-3 font-mono text-[11px] font-bold uppercase tracking-[0.16em]">
          <li><a href="#menu" class="text-cream/80 transition hover:text-butter">Menu</a></li>
          <li><a href="#about" class="text-cream/80 transition hover:text-butter">About</a></li>
          <li><a href="#craft" class="text-cream/80 transition hover:text-butter">The craft</a></li>
          <li><a href="#reviews" class="text-cream/80 transition hover:text-butter">Reviews</a></li>
        </ul>
      </nav>

      <nav aria-label="Visit links">
        <p class="eyebrow text-butter">Visit</p>
        <ul class="mt-4 space-y-3 font-mono text-[11px] font-bold uppercase tracking-[0.16em]">
          <li>
            <a href={SITE.mapsUrl} target="_blank" rel="noopener noreferrer" class="text-cream/80 transition hover:text-butter">Directions</a>
          </li>
          <li>
            <a href={SITE.phoneHref} class="text-cream/80 transition hover:text-butter">{SITE.phone}</a>
          </li>
          <li>
            <a href={SITE.instagram} target="_blank" rel="noopener noreferrer" class="text-cream/80 transition hover:text-butter">Instagram</a>
          </li>
        </ul>
      </nav>

      <div>
        <p class="eyebrow text-butter">Follow</p>
        <div class="mt-4 flex gap-3">
          <a
            href={SITE.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-11 w-11 items-center justify-center rounded-xl border-2 border-cream/40 bg-pink text-anchor transition hover:-translate-y-1"
            aria-label="NooK Café on Instagram"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="3.6" />
              <circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" />
            </svg>
          </a>
          <a
            href={SITE.phoneHref}
            class="flex h-11 w-11 items-center justify-center rounded-xl border-2 border-cream/40 bg-lavender text-anchor transition hover:-translate-y-1"
            aria-label={`Call NooK Café on ${SITE.phone}`}
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z" />
            </svg>
          </a>
        </div>
        <p class="mt-4 font-mono text-[10px] uppercase tracking-[0.16em] text-cream/50">
          {SITE.handle}
        </p>
      </div>
    </div>

    <p class="mt-10 border-t border-cream/15 pt-6 text-center font-mono text-[10px] uppercase tracking-[0.16em] text-cream/45">
      © {year} {SITE.nameAlt} · Basra, Iraq · All rights reserved
    </p>
  </div>
</footer>