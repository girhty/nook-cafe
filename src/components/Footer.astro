---
const currentYear = new Date().getFullYear();
---
<footer class="bg-brand-900 text-brand-100 py-12 border-t border-white/10">
  <div class="container mx-auto px-4 md:px-6 flex flex-col md:flex-row justify-between items-center gap-6">
    <div class="flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-brand-500" viewBox="0 0 24 24" fill="currentColor">
        <path d="M20 3H4v10c0 2.21 1.79 4 4 4h6c2.21 0 4-1.79 4-4v-3h2c1.11 0 2-.9 2-2V5c0-1.11-.89-2-2-2zm0 5h-2V5h2v3zM4 19h16v2H4v-2z"/>
      </svg>
      <span class="text-xl font-serif font-bold text-white">NooK Café</span>
    </div>
    
    <div class="text-sm text-center md:text-right text-white/50">
      <p>&copy; {currentYear} NooK Café. All rights reserved.</p>
      <p class="mt-1">Located in the heart of Basrah.</p>
    </div>
  </div>
</footer>