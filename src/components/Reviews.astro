---
const reviews = [
  {
    name: 'Hassan A.',
    role: 'Regular · Basra',
    initials: 'HA',
    color: 'bg-pop-pink',
    quote: 'The Spanish latte and the quiet corner by the window — that is my entire week sorted.',
    rating: 5,
  },
  {
    name: 'Layla M.',
    role: 'First-time visitor',
    initials: 'LM',
    color: 'bg-pop-lavender',
    quote: 'Walked in for the pizza, stayed for the playlist and the people behind the bar.',
    rating: 5,
  },
  {
    name: 'Omar K.',
    role: 'Coffee drinker',
    initials: 'OK',
    color: 'bg-butter',
    quote: 'Best hot chocolate in the city, hands down. Worth the drive from anywhere in Basra.',
    rating: 5,
  },
];

const featured = {
  name: 'Noor J.',
  role: 'Verified Google review',
  initials: 'NJ',
  color: 'bg-pop-pink',
  quote: 'EIGHT YEARS OF MAGIC. THE STAFF TREATS YOU LIKE FAMILY AND THE KITCHEN ALWAYS DELIVERS. BASRA IS LUCKIER BECAUSE OF THIS PLACE.',
  rating: 5,
  image: 'https://scontent-ams2-1.cdninstagram.com/v/t51.82787-15/780180226_18125947972707619_6388659995371475110_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=105&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiRkVFRC5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=14FZqRgdE-0Q7kNvwFTChnE&_nc_oc=Adpfi532i0EEX6qJLVyfiXNkGCXo-uqPuBge0kXW9D1MFE75iruhH1K05SsYb7Efhbw&_nc_zt=23&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=iAL__7EhTh02EJiDKyhXhA&_nc_ss=7ba8c&oh=00_AQOK51SdfAFY3bGi3y0O7-plSaVMYOC-Ac9rJoTP3nhIJw&oe=6AC10A93',
};
---
<section id="reviews" class="relative bg-cream py-28 md:py-40">
  <!-- Faded checker lead-in -->
  <div class="pointer-events-none absolute inset-x-0 top-0 grid h-8 grid-cols-24 opacity-50 md:h-12" aria-hidden="true">
    {Array.from({ length: 24 }).map((_, i) => (
      <span class={i % 2 === 0 ? 'bg-cream' : 'bg-cream-200'}></span>
    ))}
  </div>

  <div class="container-x relative">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow reveal">Customer Reviews · آراء الضيوف</p>
      <h2 class="display reveal mt-4 text-5xl text-anchor sm:text-6xl md:text-7xl md:leading-[0.85]" style="transition-delay:120ms">
        <span class="block">A Few Words</span>
        <span class="block text-stroke-anchor">From Our People.</span>
      </h2>
      <!-- Rating badge -->
      <div class="reveal mt-6 inline-flex items-center gap-3 rounded-full border-2 border-anchor bg-cream px-4 py-2 shadow-soft" style="transition-delay:240ms">
        <div class="flex">
          {[0, 1, 2, 3, 4].map(() => (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="#E9B949"><path d="M12 2l3 7h7l-5.6 4.2L18 21l-6-4-6 4 1.6-7.8L2 9h7z"/></svg>
          ))}
        </div>
        <span class="font-mono text-[11px] uppercase tracking-mono text-anchor">4.2 · Google Reviews · @nook_iraq</span>
      </div>
    </div>

    <!-- Featured review -->
    <div class="reveal mt-14 grid gap-8 rounded-[36px] border-2 border-anchor bg-cream-50 p-6 md:mt-20 md:grid-cols-12 md:gap-10 md:p-10" style="background-color:#FBF6EA; transition-delay:300ms">
      <div class="md:col-span-4">
        <img
          src={featured.image}
          alt={featured.name}
          loading="lazy"
          class="aspect-square w-full rounded-[24px] border-[5px] border-cream object-cover shadow-chunk-pink"
        />
      </div>
      <div class="relative md:col-span-8">
        <span class="display absolute -top-2 right-0 text-[120px] leading-none text-pop-lavender md:-right-2 md:-top-6 md:text-[180px]">"</span>
        <div class="relative">
          <div class="flex items-center gap-1.5">
            {[0, 1, 2, 3, 4].map(() => (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="#E9B949"><path d="M12 2l3 7h7l-5.6 4.2L18 21l-6-4-6 4 1.6-7.8L2 9h7z"/></svg>
            ))}
            <span class="font-mono text-[10px] uppercase tracking-mono text-anchor/60">5.0</span>
          </div>
          <p class="display mt-5 text-3xl text-anchor sm:text-4xl md:text-5xl md:leading-[0.95]">
            {featured.quote}
          </p>
          <div class="mt-7 flex items-center gap-3">
            <span class={`grid h-10 w-10 place-items-center rounded-full font-display text-sm text-anchor ${featured.color}`}>{featured.initials}</span>
            <div>
              <p class="font-mono text-[11px] uppercase tracking-mono text-anchor">{featured.name}</p>
              <p class="font-mono text-[10px] uppercase tracking-mono text-anchor/60">{featured.role}</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Small review row -->
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {reviews.map((r, i) => (
        <article class="reveal rounded-[24px] border-2 border-anchor bg-cream p-5 shadow-soft transition hover:-translate-y-1 hover:shadow-chunk" style={`transition-delay:${380 + i * 100}ms`}>
          <div class="flex items-center gap-3">
            <span class={`grid h-10 w-10 place-items-center rounded-full font-display text-sm text-anchor ${r.color}`}>{r.initials}</span>
            <div>
              <p class="font-mono text-[11px] uppercase tracking-mono text-anchor">{r.name}</p>
              <p class="font-mono text-[10px] uppercase tracking-mono text-anchor/60">{r.role}</p>
            </div>
          </div>
          <div class="mt-4 flex">
            {[0, 1, 2, 3, 4].map(() => (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="#E9B949"><path d="M12 2l3 7h7l-5.6 4.2L18 21l-6-4-6 4 1.6-7.8L2 9h7z"/></svg>
            ))}
          </div>
          <p class="mt-3 text-sm leading-relaxed text-anchor/80">"{r.quote}"</p>
        </article>
      ))}
    </div>

    <p class="reveal mt-10 text-center text-xs text-anchor/60" style="transition-delay:680ms">
      Be among the first to share your experience on
      <a href="https://www.google.com/maps" target="_blank" rel="noopener" class="underline hover:text-anchor">Google Maps</a>
      · 4 ratings on Google
    </p>
  </div>
</section>