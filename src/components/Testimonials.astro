---
// Mocking Reviews based on the 4.2 total rating data
const reviews = [
  {
    name: "Sarah A.",
    text: "The absolute best coffee in Basrah. The atmosphere is so quiet and relaxing. A perfect spot to get some reading done."
  },
  {
    name: "Omar K.",
    text: "I love the modern interior and the friendly staff. Their pastries are fresh every time I visit. Highly recommended!"
  },
  {
    name: "Layla M.",
    text: "Finally a café that understands specialty coffee. The latte art is beautiful and the seating is incredibly comfortable."
  }
];
---
<section id="reviews" class="py-20 bg-white overflow-hidden">
  <div class="container mx-auto px-4 md:px-6">
    <div class="text-center mb-16">
      <span class="text-brand-500 font-bold tracking-wider uppercase text-sm mb-2 block">Testimonials</span>
      <h2 class="text-3xl md:text-4xl font-serif font-bold text-brand-900 mb-6">Loved by the Community</h2>
      <div class="flex justify-center items-center gap-2">
        <div class="flex text-yellow-500 text-xl">★★★★★</div>
        <span class="font-bold text-brand-900">4.2/5.0</span>
        <span class="text-brand-900/60">on Google Maps</span>
      </div>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {reviews.map((review) => (
        <div class="bg-brand-50 p-8 rounded-2xl relative border border-brand-100">
          <div class="text-brand-500 text-4xl absolute top-4 left-6 opacity-20 font-serif">"</div>
          <p class="relative z-10 text-brand-900/80 italic mb-6 mt-2 leading-relaxed">{review.text}</p>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-brand-500 rounded-full flex items-center justify-center text-white font-bold">
              {review.name.charAt(0)}
            </div>
            <div>
              <p class="font-bold text-brand-900">{review.name}</p>
              <p class="text-xs text-brand-900/60">Local Guide</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>