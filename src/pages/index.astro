---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import Gallery from '../components/Gallery.astro';
import Testimonials from '../components/Testimonials.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

const title = 'NooK Café | Your Cozy Corner in Basrah';
const description = 'Escape to NooK Café, your cozy corner in Basrah for artisan coffee, fresh pastries, and a relaxing atmosphere. Rated 4.2 stars by our lovely community.';
---

<Layout title={title} description={description}>
	<Header />
	<main class="flex-grow">
		<Hero />
		<Features />
		<Gallery />
		<Testimonials />
		<Contact />
	</main>
	<Footer />
</Layout>