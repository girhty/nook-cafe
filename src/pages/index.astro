---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Ribbon from '../components/Ribbon.astro';
import About from '../components/About.astro';
import Signature from '../components/Signature.astro';
import Experience from '../components/Experience.astro';
import InstagramFeed from '../components/InstagramFeed.astro';
import Craft from '../components/Craft.astro';
import Reviews from '../components/Reviews.astro';
import Footer from '../components/Footer.astro';
import { MARQUEE_A, MARQUEE_B } from '../data/site.js';
---

<Layout>
  <Navbar />

  <main id="main">
    <Hero />

    <!-- Ribbon 1 — crosses the bottom edge of the hero -->
    <div class="relative z-30 -mt-14 md:-mt-20">
      <Ribbon words={MARQUEE_A} tone="pink" />
    </div>

    <About />
    <Signature />
    <Experience />
    <InstagramFeed />
    <Craft />
    <Reviews />

    <!-- Ribbon 2 — golden, scrolling the opposite way -->
    <div class="relative z-30 -mb-6 mt-8">
      <Ribbon words={MARQUEE_B} tone="golden" reverse />
    </div>
  </main>

  <Footer />
</Layout>